{
    "version": 1,
    "disable_existing_loggers": false,
    "formatters": {
      "json": {
        "()": "crest.utils.setup_logging.CrestJSONFormatter",
        "fmt_keys": {
          "level": "levelname",
          "message": "message",
          "timestamp": "timestamp",
          "logger": "name",
          "module": "module",
          "function": "funcName",
          "line": "lineno",
          "thread_name": "threadName"
        }
      }
    },
    "handlers": {
      "file": {
        "class": "logging.handlers.RotatingFileHandler",
        "level": "DEBUG",
        "formatter": "json",
        "filename": "logs/crest.log.jsonl",
        "maxBytes": 1000000,
        "backupCount": 3
      },
      "stderr": {
        "class": "logging.StreamHandler",
        "level": "WARNING",
        "formatter": "json",
        "stream": "ext://sys.stderr"
      }
    },
    "root": {
      "level": "DEBUG",
      "handlers": ["file", "stderr"]
    }
  }
  