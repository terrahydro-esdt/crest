{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "crest_json": {
      "()": "crest.utils.crest_logger.CrestJSONFormatter",
      "fmt_keys": {
        "level": "levelname",
        "logger": "name"
      }
    }
  },
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "level": "INFO",
      "formatter": "crest_json"
    },
    "app_file": {
      "class": "logging.handlers.RotatingFileHandler",
      "filename": "${LOG_FILE}",
      "mode": "a",
      "level": "INFO",
      "formatter": "crest_json",
      "maxBytes": 104857600,
      "backupCount": 10,
      "encoding": "utf-8",
      "delay": true
    },
    "metrics_file": {
      "class": "logging.handlers.RotatingFileHandler",
      "filename": "${SYS_METRICS_FILE}",
      "mode": "a",
      "level": "INFO",
      "formatter": "crest_json",
      "maxBytes": 104857600,
      "backupCount": 10,
      "encoding": "utf-8",
      "delay": true
    },
    "hindcast_file": {
      "class": "logging.handlers.RotatingFileHandler",
      "filename": "${HINDCAST_LOG_FILE}",
      "mode": "a",
      "level": "INFO",
      "formatter": "crest_json",
      "maxBytes": 104857600,
      "backupCount": 10,
      "encoding": "utf-8",
      "delay": true
    },
    "forecast_file": {
      "class": "logging.handlers.RotatingFileHandler",
      "filename": "${FORECAST_LOG_FILE}",
      "mode": "a",
      "level": "INFO",
      "formatter": "crest_json",
      "maxBytes": 104857600,
      "backupCount": 10,
      "encoding": "utf-8",
      "delay": true
    }
  },
  "loggers": {
    "crest": {
      "level": "INFO",
      "handlers": [
        "app_file",
        "console"
      ],
      "propagate": false
    },
    "crest.metrics": {
      "level": "INFO",
      "handlers": [
        "metrics_file"
      ],
      "propagate": false
    },
    "crest.hindcast": {
      "level": "INFO",
      "handlers": [
        "hindcast_file"
      ],
      "propagate": true
    },
    "crest.forecast": {
      "level": "INFO",
      "handlers": [
        "forecast_file"
      ],
      "propagate": true
    }
  },
  "root": {
    "level": "WARNING",
    "handlers": [
      "console"
    ]
  }
}