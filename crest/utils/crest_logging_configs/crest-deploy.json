{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "crest_json": {
      "()": "crest.utils.crest_logger.CrestJSONFormatter",
      "fmt_keys": {
        "level": "levelname",
        "logger": "name"
      }
    }
  },
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "level": "INFO",
      "formatter": "crest_json"
    },
    "file": {
      "class": "logging.handlers.RotatingFileHandler",
      "filename": "${LOG_FILE}",
      "maxBytes": 10485760,
      "backupCount": 14,
      "level": "INFO",
      "formatter": "crest_json",
      "encoding": "utf-8",
      "delay": true
    }
  },
  "loggers": {
    "crest": {
      "level": "INFO",
      "handlers": ["file", "console"],
      "propagate": false
    }
  },
  "root": {
    "level": "WARNING",
    "handlers": ["console"]
  }
}