{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "crest_json": {
      "()": "crest.utils.crest_logger.CrestJSONFormatter",
      "fmt_keys": {
        "level": "levelname",
        "logger": "name"
      }
    }
  },
  "handlers": {
    "api_file": {
      "class": "logging.FileHandler",
      "filename": "${API_LOG_FILE}",
      "mode": "a",
      "level": "INFO",
      "formatter": "crest_json"
    },
    "metrics_file": {
      "class": "logging.FileHandler",
      "filename": "${API_METRICS_FILE}",
      "mode": "a",
      "level": "INFO",
      "formatter": "crest_json"
    },
    "console": {
      "class": "logging.StreamHandler",
      "level": "INFO",
      "formatter": "crest_json"
    }
  },
  "loggers": {
    "crest.api": {
      "level": "INFO",
      "handlers": [
        "api_file",
        "console"
      ],
      "propagate": false
    },
    "crest.metrics": {
      "level": "INFO",
      "handlers": [
        "metrics_file"
      ],
      "propagate": false
    }
  },
  "root": {
    "level": "WARNING",
    "handlers": [
      "console"
    ]
  }
}